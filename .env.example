# Variables de entorno de las funciones /api (configurarlas en Vercel → Settings → Environment Variables).
# Para desarrollo local con `npx vercel dev`, copia este archivo a .env.local y rellénalo (NO se sube a git).
ANTHROPIC_API_KEY=sk-ant-...
APP_SECRET=un-texto-largo-y-aleatorio
# Opcionales (valores por defecto):
PLAN_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-haiku-5-5
FOOD_MODEL=claude-sonnet-5-5
MEAL_MODEL=claude-haiku-5-5
RECIPE_MODEL=claude-sonnet-5-5
